# RAKAN BALANCE — Apache fallback for static Hostinger PHP/HTML site.
# This file is copied to dist/.htaccess by Vite's public/ asset handling.
# Never rewrite requests for missing asset files to index.html.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(js|css|mjs|json|webmanifest|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|map|pdf|txt)$ [NC]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
