n adaptations of approved Cinematic UI Showcase controls.\n   Scoped classes only; no financial or storage behavior is changed. */\n\n:root {\n  --rakan-ivory: #fff8ec;\n  --rakan-gold: #d8b46a;\n  --rakan-gold-soft: #e8d7a8;\n  --rakan-emerald: #47cfa8;\n  --rakan-emerald-deep: #0b3d35;\n  --rakan-purple: #b56ce8;\n  --rakan-purple-deep: #4b145f;\n  --rakan-ink: #041210;\n}\n\n/* 1) ThreeUI-inspired cosmic glass CTA — adapted to a real submit button,\n   without the gallery canvas/background. */\n.rakan-cosmic-glass-button {\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  min-height: 58px;\n  border: 1px solid rgba(232, 215, 168, .82) !important;\n  border-radius: 18px !important;\n  color: var(--rakan-ivory) !important;\n  background:\n    radial-gradient(circle at 12% 28%, rgba(71, 207, 168, .24), transparent 28%),\n    radial-gradient(circle at 88% 82%, rgba(181, 108, 232, .30), transparent 36%),\n    linear-gradient(135deg, rgba(13, 62, 54, .86), rgba(38, 22, 55, .90) 58%, rgba(10, 31, 29, .92)) !important;\n  box-shadow:\n    inset 0 1.5px 0 rgba(255,255,255,.65),\n    inset 0 -1px 0 rgba(0,0,0,.45),\n    0 12px 30px rgba(0,0,0,.42),\n    0 0 28px rgba(181,108,232,.24),\n    0 0 18px rgba(71,207,168,.16) !important;\n  backdrop-filter: blur(18px) saturate(145%);\n  -webkit-backdrop-filter: blur(18px) saturate(145%);\n  transition: transform .28s cubic-bezier(.2,.8,.2,1), box-shadow .28s ease, border-color .28s ease;\n}\n.rakan-cosmic-glass-button::before {\n  content: \"\";\n  position: absolute;\n  inset: 1px;\n  border-radius: inherit;\n  pointer-events: none;\n  z-index: -1;\n  background:\n    linear-gradient(115deg, rgba(255,255,255,.18), transparent 24%, transparent 66%, rgba(232,215,168,.10)),\n    radial-gradient(circle at 50% 0%, rgba(255,255,255,.16), transparent 42%);\n}\n.rakan-cosmic-glass-button::after {\n  content: \"\";\n  position: absolute;\n  top: -80%;\n  bottom: -80%;\n  width: 24%;\n  left: -35%;\n  z-index: 0;\n  pointer-events: none;\n  transform: rotate(18deg);\n  background: linear-gradient(90deg, transparent, rgba(255,255,255,.48), transparent);\n  filter: blur(3px);\n  animation: rakan-cosmic-sweep 4.8s ease-in-out infinite;\n}\n.rakan-cosmic-glass-button:hover {\n  transform: translateY(-2px) scale(1.008);\n  border-color: rgba(255, 239, 197, .95) !important;\n  box-shadow:\n    inset 0 2px 0 rgba(255,255,255,.72),\n    0 15px 34px rgba(0,0,0,.48),\n    0 0 34px rgba(181,108,232,.34),\n    0 0 24px rgba(71,207,168,.22) !important;\n}\n.rakan-cosmic-glass-button:active { transform: translateY(1px) scale(.992); }\n.rakan-cosmic-glass-button:focus-visible {\n  outline: 2px solid var(--rakan-gold-soft);\n  outline-offset: 4px;\n}\n.rakan-cosmic-glass-button:disabled { opacity: .58; cursor: wait; transform: none; }\n.rakan-cosmic-orb {\n  position: relative;\n  z-index: 2;\n  width: 28px;\n  height: 28px;\n  flex: 0 0 28px;\n  border-radius: 999px;\n  background:\n    radial-gradient(circle at 34% 28%, #fff7d7 0 5%, transparent 6%),\n    radial-gradient(circle at 58% 62%, rgba(181,108,232,.96), transparent 28%),\n    conic-gradient(from 30deg, #3fe0b6, #d8b46a, #b56ce8, #246d60, #3fe0b6);\n  box-shadow:\n    inset -4px -5px 10px rgba(0,0,0,.35),\n    inset 3px 3px 7px rgba(255,255,255,.30),\n    0 0 14px rgba(71,207,168,.55),\n    0 0 22px rgba(181,108,232,.34);\n  animation: rakan-orb-drift 5.5s ease-in-out infinite;\n}\n.rakan-cosmic-orb::after {\n  content: \"\";\n  position: absolute;\n  inset: 5px;\n  border-radius: inherit;\n  border: 1px solid rgba(255,255,255,.30);\n  transform: rotate(-22deg) scaleY(.58);\n}\n.rakan-cosmic-content { position: relative; z-index: 2; }\n@keyframes rakan-cosmic-sweep {\n  0%, 58% { left: -35%; opacity: 0; }\n  67% { opacity: .8; }\n  82% { left: 112%; opacity: .15; }\n  100% { left: 112%; opacity: 0; }\n}\n@keyframes rakan-orb-drift {\n  0%,100% { transform: rotate(0deg) scale(1); }\n  50% { transform: rotate(12deg) scale(1.06); }\n}\n\n/* 2) Liquid-metal owner action — chromatic liquid reflection adapted to\n   the existing owner-login action, without introducing a heavy WebGL runtime. */\n.rakan-liquid-metal-button {\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  border: 1px solid rgba(242, 220, 171, .78) !important;\n  color: #fffaf0 !important;\n  background:\n    linear-gradient(108deg,\n      #142e2b 0%,\n      #70867f 14%,\n      #e5d6b1 27%,\n      #674b70 39%,\n      #183f38 54%,\n      #c8b985 68%,\n      #553a61 82%,\n      #132d2a 100%) !important;\n  background-size: 240% 100% !important;\n  box-shadow:\n    inset 0 2px 1px rgba(255,255,255,.72),\n    inset 0 -4px 8px rgba(0,0,0,.45),\n    0 7px 18px rgba(0,0,0,.44),\n    0 0 16px rgba(216,180,106,.18) !important;\n  text-shadow: 0 1px 2px rgba(0,0,0,.75);\n  animation: rakan-liquid-metal-flow 7s ease-in-out infinite;\n  transition: transform .22s ease, box-shadow .22s ease, filter .22s ease;\n}\n.rakan-liquid-metal-button::before {\n  content: \"\";\n  position: absolute;\n  inset: -70% -20%;\n  z-index: -1;\n  pointer-events: none;\n  background: conic-gradient(from 120deg,\n    transparent 0 18%,\n    rgba(255,255,255,.34) 23%,\n    rgba(71,207,168,.20) 30%,\n    transparent 38% 58%,\n    rgba(181,108,232,.25) 67%,\n    rgba(255,239,197,.25) 72%,\n    transparent 82%);\n  animation: rakan-liquid-metal-roll 8.5s linear infinite;\n}\n.rakan-liquid-metal-button::after {\n  content: \"\";\n  position: absolute;\n  inset: 1px;\n  z-index: -1;\n  border-radius: inherit;\n  pointer-events: none;\n  box-shadow: inset 0 0 0 1px rgba(255,255,255,.14);\n}\n.rakan-liquid-metal-button:hover {\n  transform: translateY(-1.5px);\n  filter: saturate(1.08) brightness(1.06);\n  box-shadow:\n    inset 0 2px 1px rgba(255,255,255,.82),\n    inset 0 -4px 8px rgba(0,0,0,.42),\n    0 10px 22px rgba(0,0,0,.50),\n    0 0 22px rgba(216,180,106,.28) !important;\n}\n.rakan-liquid-metal-button:active { transform: translateY(1px) scale(.99); }\n.rakan-liquid-metal-button:focus-visible { outline: 2px solid var(--rakan-gold-soft); outline-offset: 4px; }\n@keyframes rakan-liquid-metal-flow {\n  0%,100% { background-position: 0% 50%; }\n  50% { background-position: 100% 50%; }\n}\n@keyframes rakan-liquid-metal-roll { to { transform: rotate(360deg); } }\n\n/* 3) Animated submit/share treatment for WhatsApp. */\n.rakan-share-motion-button {\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  border: 1px solid rgba(171, 242, 211, .52) !important;\n  background:\n    linear-gradient(180deg, rgba(85, 225, 168, .96), rgba(18, 145, 96, .98) 54%, rgba(8, 96, 67, 1)) !important;\n  color: #fff !important;\n  box-shadow:\n    inset 0 1.5px 0 rgba(255,255,255,.52),\n    0 8px 18px rgba(5,100,69,.28),\n    0 0 0 1px rgba(216,180,106,.08) !important;\n  transition: transform .22s ease, box-shadow .22s ease, filter .22s ease;\n}\n.rakan-share-motion-button::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: linear-gradient(110deg, transparent 22%, rgba(255,255,255,.18) 44%, transparent 62%);\n  transform: translateX(-120%);\n  transition: transform .6s ease;\n}\n.rakan-share-motion-button:hover::after { transform: translateX(120%); }\n.rakan-share-motion-button:hover {\n  transform: translateY(-1px);\n  filter: brightness(1.05);\n  box-shadow:\n    inset 0 1.5px 0 rgba(255,255,255,.62),\n    0 10px 24px rgba(5,100,69,.36),\n    0 0 15px rgba(216,180,106,.14) !important;\n}\n.rakan-share-motion-button:active { transform: translateY(1px) scale(.99); }\n.rakan-share-motion-button[aria-disabled=\"true\"],\n.rakan-share-motion-button:disabled { opacity: .52; cursor: not-allowed; }\n.rakan-share-arrow {\n  position: relative;\n  z-index: 2;\n  transition: transform .35s cubic-bezier(.2,.8,.2,1);\n}\n.rakan-share-motion-button:hover .rakan-share-arrow {\n  animation: rakan-share-arrow-flight 1.25s ease-in-out infinite;\n}\n@keyframes rakan-share-arrow-flight {\n  0%,100% { transform: translate(0,0) rotate(0deg); }\n  45% { transform: translate(-4px,-3px) rotate(-8deg); }\n  70% { transform: translate(-1px,-1px) rotate(-2deg); }\n}\n\n/* 4) Synthwave laser action, recolored for the RAKAN identity. */\n.rakan-laser-button {\n  position: relative !important;\n  isolation: isolate;\n  overflow: hidden !important;\n  background: linear-gradient(180deg, rgba(24,31,38,.98), rgba(10,20,24,.99)) !important;\n  color: var(--rakan-ivory) !important;\n  border: 1px solid rgba(216,180,106,.72) !important;\n  box-shadow:\n    inset 0 0 13px rgba(71,207,168,.22),\n    0 0 16px rgba(181,108,232,.20),\n    0 6px 16px rgba(0,0,0,.34) !important;\n  text-shadow: 0 0 10px rgba(232,215,168,.32);\n  transition: transform .24s ease, box-shadow .24s ease !important;\n}\n.rakan-laser-button::before,\n.rakan-laser-button::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 54%;\n  z-index: -1;\n  pointer-events: none;\n  transform: translateX(-210%) skewX(-18deg);\n  filter: blur(2px);\n  animation: rakan-laser-pass 3.1s linear infinite;\n}\n.rakan-laser-button::before {\n  background: linear-gradient(90deg, transparent, rgba(71,207,168,.72), rgba(216,180,106,.42), transparent);\n}\n.rakan-laser-button::after {\n  background: linear-gradient(90deg, transparent, rgba(181,108,232,.68), rgba(232,215,168,.30), transparent);\n  animation-delay: 1.55s;\n}\n.rakan-laser-button:hover {\n  transform: translateY(-2px);\n  box-shadow:\n    inset 0 0 16px rgba(71,207,168,.30),\n    0 0 22px rgba(181,108,232,.30),\n    0 8px 20px rgba(0,0,0,.40) !important;\n}\n.rakan-laser-button:active { transform: scale(.98); }\n@keyframes rakan-laser-pass {\n  from { transform: translateX(-210%) skewX(-18deg); }\n  to { transform: translateX(310%) skewX(-18deg); }\n}\n\n/* 5) Mobile gradient button group — compact adaptation of the gallery bezel. */\n.rakan-gradient-mobile-nav {\n  background:\n    linear-gradient(180deg, rgba(255,255,255,.96), rgba(244,241,235,.95)) !important;\n  border-top: 1px solid rgba(185,145,77,.28) !important;\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.85),\n    0 -10px 28px rgba(15,23,42,.10) !important;\n  backdrop-filter: blur(20px) saturate(135%) !important;\n  -webkit-backdrop-filter: blur(20px) saturate(135%) !important;\n}\n.dark .rakan-gradient-mobile-nav {\n  background:\n    linear-gradient(180deg, rgba(18,43,39,.94), rgba(4,18,18,.97)) !important;\n  border-top-color: rgba(216,180,106,.34) !important;\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.12),\n    0 -10px 28px rgba(0,0,0,.26) !important;\n}\n.rakan-gradient-nav-item {\n  position: relative;\n  isolation: isolate;\n  border: 1px solid transparent;\n  color: #64748b !important;\n  background: linear-gradient(180deg, rgba(255,255,255,.28), rgba(148,163,184,.06)) padding-box !important;\n  transition: transform .22s ease, color .22s ease, box-shadow .22s ease, background .22s ease !important;\n}\n.dark .rakan-gradient-nav-item {\n  color: rgba(232, 222, 204, .76) !important;\n  background: linear-gradient(180deg, rgba(255,255,255,.025), rgba(0,0,0,.08)) padding-box !important;\n}\n.rakan-gradient-nav-item::before {\n  content: \"\";\n  position: absolute;\n  inset: 4px;\n  z-index: -1;\n  border-radius: 10px;\n  opacity: 0;\n  background: linear-gradient(180deg, rgba(80,148,128,.30), rgba(55,27,70,.42));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.14);\n  transition: opacity .22s ease;\n}\n.rakan-gradient-nav-item[data-active=\"true\"] {\n  color: #17362f !important;\n  border-color: rgba(185,145,77,.55);\n  background:\n    linear-gradient(180deg, rgba(255,255,255,.96), rgba(237,241,236,.96)) padding-box,\n    conic-gradient(from 210deg, #55d5b0, #c9a657, #b56ce8, #55d5b0) border-box !important;\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.82),\n    0 0 12px rgba(181,108,232,.10),\n    0 4px 10px rgba(15,23,42,.12) !important;\n  transform: translateY(-2px);\n}\n.dark .rakan-gradient-nav-item[data-active=\"true\"] {\n  color: #fff8ec !important;\n  border-color: rgba(216,180,106,.72);\n  background:\n    linear-gradient(180deg, rgba(28,46,43,.90), rgba(11,20,24,.96)) padding-box,\n    conic-gradient(from 210deg, #55d5b0, #d8b46a, #b56ce8, #55d5b0) border-box !important;\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.20),\n    0 0 14px rgba(181,108,232,.18),\n    0 4px 10px rgba(0,0,0,.24) !important;\n}\n.rakan-gradient-nav-item[data-active=\"true\"]::before { opacity: 1; }\n.rakan-gradient-nav-item:active { transform: translateY(1px) scale(.98); }\n.rakan-gradient-nav-item svg { transition: transform .22s ease, filter .22s ease; }\n.rakan-gradient-nav-item[data-active=\"true\"] svg {\n  transform: scale(1.06);\n  filter: drop-shadow(0 0 5px rgba(216,180,106,.35));\n}\n\n/* 6) Halo segmented control — frosted track with a sliding selected thumb. */\n.rakan-halo-segmented {\n  --halo-index: 2;\n  position: relative;\n  isolation: isolate;\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  min-height: 38px;\n  padding: 4px;\n  border-radius: 999px;\n  overflow: hidden;\n  border: 1px solid rgba(216,180,106,.28);\n  background: linear-gradient(180deg, rgba(255,255,255,.72), rgba(241,245,249,.68));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.75), 0 4px 14px rgba(15,23,42,.08);\n  backdrop-filter: blur(14px) saturate(140%);\n  -webkit-backdrop-filter: blur(14px) saturate(140%);\n}\n.dark .rakan-halo-segmented {\n  background: linear-gradient(180deg, rgba(31,63,56,.70), rgba(6,24,24,.82));\n  border-color: rgba(216,180,106,.35);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.14), 0 7px 18px rgba(0,0,0,.25);\n}\n.rakan-halo-segmented__aura {\n  position: absolute;\n  inset: auto -15% -26px;\n  height: 42px;\n  z-index: -2;\n  opacity: .62;\n  filter: blur(16px);\n  background: linear-gradient(90deg, rgba(71,207,168,.65), rgba(216,180,106,.60), rgba(181,108,232,.68));\n  animation: rakan-halo-breathe 4.6s ease-in-out infinite;\n}\n.rakan-halo-segmented__thumb {\n  position: absolute;\n  z-index: -1;\n  top: 4px;\n  bottom: 4px;\n  left: 4px;\n  width: calc((100% - 8px) / 3);\n  border-radius: 999px;\n  border: 1px solid rgba(232,215,168,.56);\n  background:\n    linear-gradient(180deg, rgba(255,255,255,.92), rgba(239,230,211,.74));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.82), 0 2px 8px rgba(0,0,0,.10);\n  transform: translateX(calc(var(--halo-index) * 100%));\n  transition: transform .42s cubic-bezier(.22,1,.36,1), background .25s ease;\n}\n.dark .rakan-halo-segmented__thumb {\n  background: linear-gradient(180deg, rgba(91,108,96,.68), rgba(28,30,41,.86));\n  border-color: rgba(232,215,168,.45);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 4px 12px rgba(0,0,0,.28);\n}\n.rakan-halo-segmented button {\n  position: relative;\n  z-index: 2;\n  min-width: 0;\n  border: 0;\n  border-radius: 999px;\n  padding: 7px 8px;\n  background: transparent !important;\n  box-shadow: none !important;\n  color: #64748b !important;\n  font-size: 11px;\n  font-weight: 700;\n  cursor: pointer;\n  transition: color .22s ease, transform .22s ease;\n}\n.dark .rakan-halo-segmented button { color: #cbd5e1 !important; }\n.rakan-halo-segmented button[data-active=\"true\"] { color: #18211f !important; }\n.dark .rakan-halo-segmented button[data-active=\"true\"] { color: #fff8ec !important; }\n.rakan-halo-segmented button:active { transform: scale(.97); }\n.rakan-halo-segmented button:focus-visible { outline: 2px solid rgba(216,180,106,.8); outline-offset: 1px; }\n@keyframes rakan-halo-breathe {\n  0%,100% { transform: translateX(-4%); opacity: .42; }\n  50% { transform: translateX(4%); opacity: .70; }\n}\n\n@media (max-width: 520px) {\n  .rakan-cosmic-glass-button { min-height: 54px; }\n  .rakan-cosmic-orb { width: 24px; height: 24px; flex-basis: 24px; }\n  .rakan-gradient-nav-item { min-height: 52px !important; border-radius: 12px !important; }\n  .rakan-halo-segmented button { padding-inline: 5px; font-size: 10px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .rakan-cosmic-glass-button::after,\n  .rakan-cosmic-orb,\n  .rakan-liquid-metal-button,\n  .rakan-liquid-metal-button::before,\n  .rakan-share-motion-button:hover .rakan-share-arrow,\n  .rakan-laser-button::before,\n  .rakan-laser-button::after,\n  .rakan-halo-segmented__aura {\n    animation: none !important;\n  }\n  .rakan-cosmic-glass-button,\n  .rakan-liquid-metal-button,\n  .rakan-share-motion-button,\n  .rakan-laser-button,\n  .rakan-gradient-nav-item,\n  .rakan-halo-segmented__thumb {\n    transition-duration: .01ms !important;\n  }\n}\n"]],"\n  ",["BODY",{"class":"bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased font-sans selection:bg-emerald-500/20 selection:text-emerald-700 dark:selection:text-emerald-300"},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"min-h-screen bg-slate-50 dark:bg-transparent flex flex-col items-center justify-center p-4 text-center","dir":"rtl"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:3005/assets/rakan-icon-192.webp","alt":"أيقونة راكان بلانس","class":"w-16 h-16 object-contain rounded-2xl mb-3 shadow-lg","width":"64","height":"64","decoding":"async","src":"/assets/rakan-icon-192.webp"}],["DIV",{"class":"text-sm font-bold text-slate-800 dark:text-slate-200"},"راكان بلانس | RAKAN BALANCE"],["DIV",{"class":"text-xs text-slate-400 mt-1"},"جاري تحميل بيانات الذمم المالية..."]]],"\n    ","\n  \n\n\n"]],"viewport":{"width":1280,"height":720},"timestamp":11585.481,"wallTime":1795114709760,"collectionTime":1.7999999998137355,"resourceOverrides":[],"isMainFrame":true}}
