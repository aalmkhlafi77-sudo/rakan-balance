# RAKAN BALANCE — Owner API (Phase A). Do not commit actual secrets.
# Hostinger Business: set these in the app's private server environment.
APP_ORIGIN=https://rakan.carpetbazar.org
PORT=3000

# Dedicated MySQL database, not shared with any other website.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_prefix_rakan
DB_USER=your_hostinger_database_user
DB_PASSWORD=SET_IN_HOSTINGER_SECRETS_ONLY

# Generate at least 32 cryptographically random characters; store on server only.
RAKAN_CSRF_SECRET=SET_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# One-time administrative provisioning ONLY (not a persistent production variable):
# RAKAN_OWNER_PASSWORD is read by npm run provision:owner
# NEVER expose it via VITE_ variables, GitHub, browser code or app logs.
