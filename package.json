{
  "name": "rakan-balance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && npm run build:validator",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/run_all_tests.ts",
    "test:e2e": "playwright test",
    "start": "node server/start.mjs",
    "test:server": "npm run build:validator && node --test server/tests/*.test.mjs",
    "provision:owner": "node server/scripts/provision-owner.mjs",
    "build:validator": "esbuild server/validator-entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=server/generated/owner-validator.mjs",
    "test:owner-adapter": "tsx --test tests/owner-remote-storage.test.ts",
    "backup:scheduled": "node server/scripts/run-scheduled-owner-backup.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fake-indexeddb": "^6.2.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "@andreeewill/exceljs": "5.0.3",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "@playwright/test": "^1.56.0"
  }
}
